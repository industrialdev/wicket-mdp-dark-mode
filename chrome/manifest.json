{
  "manifest_version": 3,
  "name": "MDP Dark Mode",
  "version": "1.0.0",
  "description": "Dark mode for the Wicket MDP admin panel",
  "author": "EstebanForge",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://admin.staging.wicketcloud.com/*",
        "https://admin.wicketcloud.com/*",
        "https://*.wicketcloud.com/*"
      ],
      "js": ["content.js"],
      "css": ["dark.css"],
      "run_at": "document_start"
    }
  ]
}
